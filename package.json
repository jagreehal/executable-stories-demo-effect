{
  "name": "executable-stories-demo-effect",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "STORY_REPORT=1 vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.include='src/rob/**'",
    "mutation": "stryker run",
    "mutation:incremental": "stryker run --incremental",
    "demo:reset": "cp src/rob/index.test.ts.before src/rob/index.test.ts",
    "dev": "bun --hot scripts/dev.ts",
    "diagram": "effect-analyze ./src/effect.test.ts",
    "diagram:watch": "effect-analyze ./src/effect.test.ts --watch"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "executable-stories-formatters": "1.20.0",
    "executable-stories-vitest": "8.9.5",
    "live-server": "1.2.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115",
    "effect-analyzer": "3.6.0"
  }
}